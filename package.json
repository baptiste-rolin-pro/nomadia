{
  "name": "nomadia",
  "version": "0.1.0",
  "private": true,
  "description": "Nomadia — plateforme de voyage immersive (démonstration P0).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:deploy": "npm run db:migrate && npm run db:seed",
    "vercel-build": "npm run db:deploy && next build",
    "setup": "npm run db:migrate && npm run db:seed",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "links:check": "tsx scripts/check-external-links.ts",
    "e2e:prepare": "tsx scripts/e2e-prepare.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@electric-sql/pglite": "0.5.16",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.70.0",
    "motion": "14.11.1",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
