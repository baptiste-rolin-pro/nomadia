# ---------------------------------------------------------------------------
# Nomadia — variables d'environnement (copier en .env.local)
# Toutes les variables sont lues côté SERVEUR uniquement : aucune n'est exposée au navigateur
# (aucune variable NEXT_PUBLIC_*). Les valeurs ci-dessous sont factices.
# ---------------------------------------------------------------------------

# URL publique du site (liens des emails, canonicals, sitemap).
NOMADIA_SITE_URL=http://localhost:3000
# demo | staging | production — seule « production » autorise l'indexation par les moteurs.
NOMADIA_SITE_ENV=demo

# SECRET — 32 caractères minimum, obligatoire si NOMADIA_SITE_ENV=production.
# Générer par exemple avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum

# Base de données. Sans DATABASE_URL : PostgreSQL embarqué (PGlite) dans PGLITE_DATA_DIR.
# SECRET si renseigné. Exemple : postgres://utilisateur:motdepasse@hote:5432/nomadia
# DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Modes fournisseurs par service : demo | sandbox | live (jamais modifiables par l'URL).
FLIGHTS_PROVIDER_MODE=demo
HOTELS_PROVIDER_MODE=demo
CARS_PROVIDER_MODE=demo

# SECRET — jeton Duffel (test « duffel_test_… » en sandbox). Non fourni dans ce dépôt.
# DUFFEL_ACCESS_TOKEN=
# SECRET — accès partenaire Booking.com Demand API (connecteur non implémenté, voir docs/providers.md).
# BOOKING_DEMAND_API_KEY=
# BOOKING_DEMAND_AFFILIATE_ID=

# Vente réelle : à n'activer qu'après validations contractuelles et réglementaires (Atout France, etc.).
NOMADIA_LIVE_SALES_APPROVED=false

# Emails : « capture » enregistre les emails en base sans les envoyer.
MAIL_TRANSPORT=capture
MAIL_FROM="Nomadia <no-reply@nomadia.example>"
# Boîte de test /dev/boite-mail (liens de vérification visibles) : JAMAIS sur un site public.
NOMADIA_DEV_MAILBOX=true

# SECRET — signature des événements du prestataire de paiement de démonstration (16 caractères minimum),
# obligatoire si NOMADIA_SITE_ENV=production. Sans valeur (hors production) : secret aléatoire propre au
# processus et webhook HTTP /api/demo/webhooks/payment fermé (404).
DEMO_WEBHOOK_SECRET=remplacer-par-un-secret-de-demo

# SECRET — jeton pour /api/jobs/run (ordonnanceur externe). Laisser vide pour désactiver.
# NOMADIA_JOB_RUNNER_TOKEN=

# Horloge figée pour les tests (ISO 8601). Laisser vide en usage normal.
# NOMADIA_FIXED_NOW=

# Comptes de démonstration créés par `npm run db:seed` (valeurs de TEST, jamais de vrais mots de passe).
# Valeurs par défaut si absentes : voyage-demo-2026 / admin-demo-2026
DEMO_USER_PASSWORD=voyage-demo-2026
DEMO_ADMIN_PASSWORD=admin-demo-2026
