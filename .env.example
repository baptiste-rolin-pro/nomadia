# ---------------------------------------------------------------------------
# Nomadia — variables d'environnement (copier en .env.local pour le développement local)
# Toutes les variables sont lues côté SERVEUR uniquement : aucune n'est exposée au navigateur
# (aucune variable NEXT_PUBLIC_*). Les valeurs ci-dessous sont factices.
# Déploiement Vercel : voir README.md, section « Déploiement sur Vercel » (tableau complet des variables).
# Les scripts npm run db:* lisent aussi ce fichier .env.local (comme Next.js), sans afficher les valeurs.
# ---------------------------------------------------------------------------

# URL publique du site (liens des emails, canonicals, origine acceptée par l'authentification, cookies Secure).
# Sur Vercel, à défaut : https://$VERCEL_PROJECT_PRODUCTION_URL (production) ou l'URL de branche (aperçu).
NOMADIA_SITE_URL=http://localhost:3000
# demo | staging | production — seule « production » autorise l'indexation par les moteurs.
NOMADIA_SITE_ENV=demo

# Inscription publique et réinitialisation du mot de passe par email.
# false (défaut, site de démonstration public) : aucune création de compte, aucune adresse email demandée,
#   connexion avec les comptes de démonstration PARTAGÉS (identifiants affichés sur /connexion), formulaire de
#   contact et voyageurs enregistrés désactivés, adresse de contact des réservations fictive obligatoire.
# true : inscription, vérification d'adresse et réinitialisation (en local avec NOMADIA_DEV_MAILBOX=true).
NOMADIA_PUBLIC_SIGNUP=false

# SECRET — 32 caractères minimum, obligatoire si NOMADIA_SITE_ENV=production et sur tout déploiement Vercel.
# Générer par exemple avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum

# Base de données. Sans DATABASE_URL : PostgreSQL embarqué (PGlite) dans PGLITE_DATA_DIR (local uniquement).
# SECRET si renseigné. Obligatoire sur Vercel. Neon : chaîne « pooled » (hôte -pooler), avec ?sslmode=require.
# Exemple : postgresql://utilisateur:motdepasse@ep-exemple-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=
# SECRET — Neon : chaîne DIRECTE (sans -pooler), utilisée seulement par db:migrate / db:seed (verrou consultatif).
# DATABASE_URL_UNPOOLED=
PGLITE_DATA_DIR=.data/pglite

# Modes fournisseurs par service : demo | sandbox | live (jamais modifiables par l'URL).
FLIGHTS_PROVIDER_MODE=demo
HOTELS_PROVIDER_MODE=demo
CARS_PROVIDER_MODE=demo

# SECRET — jeton Duffel (test « duffel_test_… » en sandbox). Non fourni dans ce dépôt.
# DUFFEL_ACCESS_TOKEN=
# SECRET — accès partenaire Booking.com Demand API (connecteur non implémenté, voir docs/providers.md).
# BOOKING_DEMAND_API_KEY=
# BOOKING_DEMAND_AFFILIATE_ID=

# Vente réelle : à n'activer qu'après validations contractuelles et réglementaires (Atout France, etc.).
NOMADIA_LIVE_SALES_APPROVED=false

# Emails : « capture » enregistre les emails en base sans les envoyer.
MAIL_TRANSPORT=capture
MAIL_FROM="Nomadia <no-reply@nomadia.example>"
# Boîte de test /dev/boite-mail (liens de vérification visibles) : développement local UNIQUEMENT.
# Interdite si NOMADIA_SITE_ENV=production et sur le déploiement de production Vercel.
NOMADIA_DEV_MAILBOX=true

# SECRET — signature des événements du prestataire de paiement de démonstration (16 caractères minimum),
# obligatoire si NOMADIA_SITE_ENV=production. Sans valeur (hors production) : secret aléatoire propre au
# processus et webhook HTTP /api/demo/webhooks/payment fermé (404) ; le paiement simulé fonctionne quand même.
DEMO_WEBHOOK_SECRET=remplacer-par-un-secret-de-demo

# SECRET — envoyé automatiquement par Vercel Cron (Authorization: Bearer …) à GET /api/jobs/run (vercel.json).
# 16 caractères minimum, lettres et chiffres. Sans valeur : /api/jobs/run répond 401.
# CRON_SECRET=
# SECRET — jeton d'un ordonnanceur externe pour /api/jobs/run (GET ou POST). Laisser vide pour désactiver.
# NOMADIA_JOB_RUNNER_TOKEN=

# Horloge figée pour les tests (ISO 8601). Laisser vide en usage normal ; jamais sur Vercel.
# NOMADIA_FIXED_NOW=

# Comptes de démonstration créés / resynchronisés par `npm run db:seed` : valeurs de TEST PUBLIQUES,
# affichées sur la page de connexion quand NOMADIA_PUBLIC_SIGNUP=false. Jamais de vrais mots de passe.
# 10 caractères minimum. Valeurs par défaut si absentes : voyage-demo-2026 / admin-demo-2026
DEMO_USER_PASSWORD=voyage-demo-2026
DEMO_ADMIN_PASSWORD=admin-demo-2026

# ---------------------------------------------------------------------------
# Assistant de recherche de l'accueil (API Anthropic, modèle claude-opus-5-5) — voir docs/providers.md.
# SECRET — clé d'API Anthropic (Console Anthropic). Sans valeur : l'onglet « Assistant » affiche « indisponible »,
# /api/assistant répond 503 et le reste du site fonctionne normalement. Seule source d'identifiants utilisée.
# ANTHROPIC_API_KEY=
# Demandes par visiteur (empreinte HMAC de l'adresse IP) et par heure. Défaut : 20.
NOMADIA_ASSISTANT_IP_HOURLY_LIMIT=20
# Plafond global de demandes par jour UTC, tous visiteurs confondus (borne le coût). 0 ferme l'assistant. Défaut : 300.
NOMADIA_ASSISTANT_DAILY_LIMIT=300
# Tests de parcours uniquement : « e2e » remplace le modèle par une simulation locale (aucun appel réseau).
# Interdit sur Vercel et lorsque NOMADIA_SITE_ENV=production (erreur de configuration explicite).
# NOMADIA_ASSISTANT_MOCK=off
